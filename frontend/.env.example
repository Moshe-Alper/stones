# Contact inquiry email delivery — server-only, never prefix with NEXT_PUBLIC_.
# One of: email | simulate
#   email    -> sends real messages via Resend. Requires RESEND_API_KEY,
#               CONTACT_INQUIRY_FROM, CONTACT_INQUIRY_TO.
#   simulate -> accepts the inquiry as delivered without calling Resend.
#               Local/dev/test only. Real production deployments must never
#               set this value; any other/missing value fails closed (503).
CONTACT_INQUIRY_DELIVERY_MODE=simulate

# Resend's canonical server-side API key name (matches Resend's own docs/
# dashboard/CLI/Vercel integration — do not rename).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified Resend sender address (domain must be verified in Resend).
CONTACT_INQUIRY_FROM="Alper Marble <inquiries@mail.alper-marble.co.il>"

# Internal recipient for contact inquiry notifications (business config, not code).
CONTACT_INQUIRY_TO=moshe@alper-marble.co.il
