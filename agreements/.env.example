# Owner login (single user). Use a long random password.
OWNER_PASSWORD=change-me
# Random 32+ char string used to sign the owner session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: public base URL used to build signing links (defaults to the request origin).
APP_BASE_URL=

# Optional: email the owner when an agreement is signed (Resend). Without these, the event is only logged.
RESEND_API_KEY=
MAIL_FROM=
OWNER_EMAIL=
